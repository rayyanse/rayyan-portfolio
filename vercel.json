{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "rayyan-portfolio-psi.vercel.app"
        }
      ],
      "destination": "https://rayyankhan.dev/$1",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/agha-muhammad-rayyan-khan-resume.pdf",
      "permanent": false
    }
  ]
}
